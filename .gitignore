# ==========================================
# 1. 忽略 Mac 系统自动生成的恶心缓存文件
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# ==========================================
# 2. 忽略编译器和 IDE 的本地配置（保留你的专属透视挂）
# ==========================================
.vscode/
!.vscode/c_cpp_properties.json
.idea/
*.suo
*.user

# ==========================================
# 3. 忽略整个 CMake 编译生成的庞大产物目录
# ==========================================
build/

# ==========================================
# 4. 放行规则：日志正常上传，源码绝对不丢
# ==========================================
# 允许追踪 logs 文件夹下的所有 markdown 开发日志
!logs/
!logs/*.md

# 显式放行核心源码与头文件，防止被其他潜在规则误杀
!src/
!include/
!CMakeLists.txt
!README.md